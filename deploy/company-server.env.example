# Copy to /root/company-server.env and chmod 0600. Never commit real values.
COMPANY_DOMAIN=shenzhen.example.com
COMPANY_CN_EXIT_IPV4=203.0.113.10
COMPANY_CN_DNS_IPV4_1=192.0.2.53
COMPANY_CN_DNS_IPV4_2=192.0.2.54

COMPANY_US_EXIT_IPV4=198.51.100.10
COMPANY_US_NODE_IPV4=198.51.100.10
COMPANY_US_ANYTLS_PORT=443
COMPANY_US_HY2_PORT=8443
COMPANY_US_TUIC_PORT=9443

COMPANY_DATABASE_NAME=jackye
COMPANY_DATABASE_USER=jackye
# Fresh-install only. Generate unique values; keep the real env root:root 0600.
COMPANY_DATABASE_PASSWORD='REPLACE_WITH_UNIQUE_12_PLUS_CHARACTERS'
COMPANY_ADMIN_EMAIL=admin@example.com
COMPANY_ADMIN_PASSWORD='REPLACE_WITH_UNIQUE_12_PLUS_CHARACTERS'
COMPANY_US_PROXY_ID=1
COMPANY_CN_PROXY_ID=4

COMPANY_US_SOCKS_PORT=11000
COMPANY_CN_SOCKS_PORT=13001
COMPANY_ENABLE_PUBLIC_TLS=1

# Optional ingress mode. Unset preserves the legacy switch above:
# 1=public-https, 0=preserve (SSH tunnel or manually managed nginx).
# LAN HTTP does not alter AI egress/TLS/ProxyID/nftables policies.
# For HTTP, set COMPANY_ENABLE_PUBLIC_TLS=0 and explicitly configure:
# COMPANY_WEB_MODE=http
# COMPANY_DOMAIN=hsaiapi.company.example
# COMPANY_WEB_LISTEN_IP=192.168.1.175
# COMPANY_WEB_ALLOW_CIDRS=192.168.1.0/24,172.16.40.0/24
# COMPANY_HTTP_ACKNOWLEDGE_PLAINTEXT=1
